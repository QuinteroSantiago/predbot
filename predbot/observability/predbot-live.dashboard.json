{
  "uid": "predbot-live",
  "title": "predbot \u2014 Live Bot",
  "description": "Live execution monitor for predbot-live (real-money MLB arb, minimum-risk caps). Order placements, fills, hedges and kills come from the bot's logs (Loki); money, positions and unhedged legs from its metrics. Quiet is normal \u2014 it only fires on a vetted MLB edge.",
  "tags": [
    "predbot",
    "live",
    "trading"
  ],
  "editable": true,
  "timezone": "",
  "schemaVersion": 39,
  "refresh": "30s",
