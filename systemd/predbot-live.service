# predbot LIVE TRADING — REAL ORDERS, REAL MONEY (design §8, §11, §17 Phase 4).
#
# Deliberately NOT enabled at boot: a reboot must never silently resume trading.
# Operate it ONLY via scripts/trading.sh (start runs preflight first; stop/kill/
# clear/deploy-live) — see the operator manual, https://rpi5/predbot-manual.html.
# deploy-live installs this file; editing it on the VM is overwritten next deploy.
#
# Restart=no is also deliberate. If the process dies mid-pair it may hold an
# unhedged position; an automatic restart could compound that before a human
# looks. Startup reconciliation runs on every manual start.
[Unit]
Description=predbot LIVE TRADING (real orders, real money)
After=network-online.target chronyd.service
Wants=network-online.target

[Service]
Type=simple
User=predbot
Group=predbot
WorkingDirectory=/opt/predbot
# MINIMUM-RISK caps (since 2026-08-28): smallest possible size + tight guards.
#   -max-order-contracts=1   one contract per leg — the smallest bet there is.
#   -max-unhedged-contracts=2  NOT 1: the Kalshi exchange-side order group is
#     sized to this cap (cmd/live ~L220), and the safety EXIT of a naked Kalshi
#     leg is itself a Kalshi order. A limit of 1 would let the entry through but
#     block its own exit. 2 leaves room for entry + exit; with 1-contract orders
#     the real naked exposure is still ~1 contract (~$1 worst case).
#   -pnl-floor-usd=-5        halt after $5 of realized loss — a hard backstop.
#   -min-depth-contracts=10  both legs need 10 contracts of real depth before we
#     act (10x our order size) — the phantom-edge guard that the 2026-08-24
#     naked-leg incident was missing.
#   -sports=mlb,nfl          the universe: daily games discovered at runtime
#     (markets.yaml is empty). Keep predbot-record.service's -sports in step.
# NOTE: this is not a profit run — at 1 contract the dollars are trivial either
# way. It is a live validation run: does the maker path (below) actually fill,
# hedge and earn the rebate with real money.
ExecStart=/opt/predbot/predbot-live \
  -config /opt/predbot/config/config.yaml \
  -markets /opt/predbot/config/markets.yaml \
  -dry-run=false \
  -i-understand-this-places-real-orders \
  -max-order-contracts=1 \
  -max-unhedged-contracts=2 \
  -pnl-floor-usd=-5 \
  -min-depth-contracts=10 \
  -sports=mlb,nfl \
  -maker
# -maker (2026-09-10): MAKER mode — rest one leg (earns the Poly rebate), hedge
# the other on fill. This INVERTS the taker path's naked-leg-impossible
# sequencing: a filled rest is naked on the resting venue until the hedge lands,
# so the 1-contract / 2-unhedged / -$5 caps above are doing real work here. This
# is the live fill-through validation the backtest cannot prove (design §9.2).

# SIGUSR1 = engage the kill switch without stopping (writes the KILLED marker,
# which then blocks any restart until a human removes it).
ExecReload=/bin/kill -USR1 $MAINPID

Restart=no
KillSignal=SIGTERM
TimeoutStopSec=30

EnvironmentFile=/etc/predbot/env
Environment=OTEL_EXPORTER_OTLP_ENDPOINT=http://192.168.3.198:4318
Environment=OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
Environment=OTEL_SERVICE_NAME=predbot-live
Environment=OTEL_METRIC_EXPORT_INTERVAL=10000

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/predbot
StateDirectory=predbot

# NOT [Install]-enabled on purpose — no WantedBy, so `systemctl enable` is an
# explicit, deliberate act rather than something that happens by default.
[Install]
WantedBy=
