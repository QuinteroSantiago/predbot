# Recorded market data and local state.
/data/
*.jsonl
*.jsonl.gz

# Credentials NEVER belong here — they live in /etc/predbot/env (0600) on the
# host, injected via the units' EnvironmentFile. See config/config.yaml.
.env
*.pem
*.key
